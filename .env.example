# pitmry Environment Configuration (.env.local)
# Copy this file to .env.local to customize local configuration.

# Python executable (auto-detected from .venv or system PATH by default)
# PYTHON_BIN=/usr/bin/python3

# Backend bridge script (auto-detected from ./server/memory_dashboard_api.py)
# MEMORY_API_SCRIPT=./server/memory_dashboard_api.py

# SQLite database file path (defaults to ~/.cavemem/data.db, local fallback to ./data/memory.db)
# CAVEMEM_DB_PATH=~/.cavemem/data.db

# LanceDB columnar vector storage directory (defaults to ~/.strategic_memory/lancedb)
# LANCEDB_DIR=~/.strategic_memory/lancedb

# Tracked git repository paths (comma-separated or JSON)
# TRACKED_REPOS=./,../portfolio,../other-project

# Agent Skills directory (defaults to ~/.agents/skills or ./.agents/skills)
# AGENTS_SKILLS_PATH=~/.agents/skills
