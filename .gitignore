# Dependencies
node_modules/

# Build output
.next/
out/

# Environment files — never commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Python virtual environment & caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Local data & database instances
data/

*.sqlite
*.db

# PITMRY canonical memory is Git-tracked — this is the source of truth.
# Only the disposable derived cache is ignored.
.pitmry-cache/
pitmry.config.json

# Existing dashboard UI state and runtime logs that live under .pitmry/.
# They are not canonical memory and must never be committed.
/.pitmry/onboarding.json
/.pitmry/server.log
/.pitmry/server.log.*

# Temporary imports & staging
.temp/
